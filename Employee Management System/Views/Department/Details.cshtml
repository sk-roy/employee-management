@using Employee_Management_System.Models.ViewModels
@model DepartmentViewModel

@{
    ViewData["Title"] = "Department Details";
}

<h1>Department Details</h1>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DepartmentId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.DepartmentId)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DepartmentName)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.DepartmentName)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Budget)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Budget)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Spent)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Spent)
        </dd>
    </dl>
</div>


<hr />

<h3> Employees (@Model.Employees.Count())</h3>

@if (Model.Employees.Any())
{
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Salary</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model.Employees)
            {
                <tr>
                    <td>@report.FirstName @report.LastName</td>
                    <td>@report.Email</td>
                    <td>@report.Salary</td>
                    <td>
                        <dd class="col-sm-9">
                            <span class="badge @(report.IsActive ? "bg-success" : "bg-danger")">
                                @(report.IsActive ? "Active" : "Inactive")
                            </span>
                        </dd>
                    </td>
                    <td>
                        <a asp-action="Details" asp-controller="Employee" asp-route-id="@report.EmployeeId" class="btn btn-sm btn-outline-info">View Employee</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>This department currently has no employees.</p>
}

<hr />

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.DepartmentId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>