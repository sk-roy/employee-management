@model IEnumerable<Employee_Management_System.Models.OrganizationHierarchy>

@{
    ViewData["Title"] = "Organization Chart";
}

<h1>@ViewData["Title"]</h1>
<p class="text-muted">Shows the full reporting hierarchy derived from the Manager ID chain.</p>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-warning" role="alert">
        No employee data found to generate the organizational hierarchy.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.EmployeeName)</th>
                <th>@Html.DisplayNameFor(model => model.HierarchyLevel)</th>
                <th>@Html.DisplayNameFor(model => model.FullManagerChain)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div style="padding-left: @(item.HierarchyLevel * 40)px; font-weight: @(item.HierarchyLevel == 1 ? "bold" : "normal");">
                            @item.EmployeeName
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-secondary">Level @item.HierarchyLevel</span>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FullManagerChain)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-4">
    <a asp-action="Index" asp-controller="Employee" class="btn btn-secondary">Back to Employee List</a>
</div>