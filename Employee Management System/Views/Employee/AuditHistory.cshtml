@model IEnumerable<Employee_Management_System.Models.EmployeeAuditModel>

@{
    ViewData["Title"] = "Audit History";
    var employeeName = ViewData["EmployeeName"] as string;
    var employeeId = (int)ViewData["EmployeeId"];
}

<h1>🔍 Audit History</h1>
<h2>Changes for @employeeName (ID: @employeeId)</h2>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No audit records found for this employee.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.ChangeDate)</th>
                <th>@Html.DisplayNameFor(model => model.ChangeType)</th>
                <th>@Html.DisplayNameFor(model => model.FieldName)</th>
                <th>@Html.DisplayNameFor(model => model.OldValue)</th>
                <th>@Html.DisplayNameFor(model => model.NewValue)</th>
                <th>@Html.DisplayNameFor(model => model.ChangedBy)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ChangeDate.ToString("g")</td>
                    <td><span class="badge bg-secondary">@item.ChangeType</span></td>
                    <td>@item.FieldName</td>
                    <td><del>@item.OldValue</del></td>
                    <td><strong>@item.NewValue</strong></td>
                    <td>@item.ChangedBy</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-4">
    <a asp-action="Details" asp-route-id="@employeeId" class="btn btn-secondary">Back to Employee Details</a>
</div>