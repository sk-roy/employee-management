@model IEnumerable<Employee_Management_System.Models.ProjectOverlapModel>

@{
    ViewData["Title"] = "Project Overlap Analysis";
}

<h1>@ViewData["Title"]</h1>
<p class="text-danger">The following project pairs have conflicting on schedules for an Employee.</p>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-success" role="alert">
        No schedule conflicts found between active employees and projects!
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Employee Name</th>
                <th>Project 1 Name</th>
                <th>Project 2 Name</th>
                <th>Duration (Project 1)</th>
                <th>Duration (Project 2)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.EmployeeName</strong><br />
                    </td>
                    <td>
                        <strong>@item.ProjectName1</strong><br />
                    </td>
                    <td>
                        <strong>@item.ProjectName2</strong><br />
                    </td>
                    <td>
                        @item.StartDateProject1.ToShortDateString() - @item.EndDateProject1.ToShortDateString()
                    </td>
                    <td>
                        @item.StartDateProject2.ToShortDateString() - @item.EndDateProject1.ToShortDateString()
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">Back to Project List</a>
</div>
