@model IEnumerable<Employee_Management_System.Models.Project>

@{
    ViewData["Title"] = "All Projects";
}

<div class="d-flex justify-content-between align-items-center header-row mb-3">
    <h2>@ViewData["Title"]</h2>
    <div>
        <a asp-action="Overlap" class="btn btn-success">Project Overlap List</a>
        <a asp-action="Create" class="btn btn-success">Add New Project</a>
    </div>
</div>
<hr />

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.ProjectName)</th>
            <th>@Html.DisplayNameFor(model => model.StartDate)</th>
            <th>@Html.DisplayNameFor(model => model.EndDate)</th>
            <th>@Html.DisplayNameFor(model => model.HoursWorked)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.ProjectName)</td>
                <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                <td>@Html.DisplayFor(modelItem => item.HoursWorked)</td>
                <td>
                    @{
                        string badgeClass = item.Status switch
                        {
                            "Completed" => "bg-success",
                            "OnHold" => "bg-warning text-dark",
                            _ => "bg-primary",
                        };
                    }
                    <span class="badge @badgeClass">@item.Status</span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProjectId" class="btn btn-sm btn-info">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.ProjectId" class="btn btn-sm btn-secondary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>